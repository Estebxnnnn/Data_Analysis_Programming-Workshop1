# Secrets
.env

# Raw landing zone: git-ignored except small samples and placeholders
data/raw/*
!data/raw/.gitkeep

# Large downloads produced by the notebook
workshop_1/samples/*.full.*

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/

# Editors / OS
.vscode/
.idea/
.DS_Store

# Airflow runtime
airflow/logs/*
!airflow/logs/.gitkeep
datalake_bronze/_staging/*
!datalake_bronze/_staging/.gitkeep

# Workshop 3: historical reference (rebuilt by the Gold DAG; reference_stats.json is kept)
datalake_bronze/_reference/*
!datalake_bronze/_reference/.gitkeep
datalake_silver/_reference/*.parquet
datalake_gold/_tmp_*/
