digraph G {
  rankdir=LR; nodesep=0.25; ranksep=0.45; splines=spline;
  node [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled", fillcolor="#f2f4f7", color="#7b8794"];
  edge [fontname="Helvetica", fontsize=8.5, color="#52606d", arrowsize=0.7];
  subgraph cluster_src { label="Sources"; fontname="Helvetica-Bold"; fontsize=10; color="#9aa5b1"; style="rounded";
    gd [label="GDACS event API\n(hourly, 7-day window)"];
    ia [label="IBTrACS ACTIVE\n(conditional GET)"];
    ih [label="IBTrACS since1980\n(checked weekly)"];
  }
  subgraph cluster_af { label="Airflow 2.10.5 - Docker Compose, LocalExecutor"; fontname="Helvetica-Bold"; fontsize=10; color="#9aa5b1"; style="rounded";
    bd [label="bronze_ingestion\nhourly :00", fillcolor="#e3ecf5"];
    sd [label="silver_processing\n*/15 + FileSensor", fillcolor="#e3ecf5"];
    gp [label="gold_processing\nhourly :40\nPySpark local[2]", fillcolor="#e3ecf5"];
  }
  subgraph cluster_lake { label="Data lake (bind-mounted folders)"; fontname="Helvetica-Bold"; fontsize=10; color="#9aa5b1"; style="rounded";
    b  [shape=cylinder, label="datalake_bronze/\nraw JSON\n_state/  _errors/"];
    s  [shape=cylinder, label="datalake_silver/\nParquet + _manifest.jsonl"];
    r  [shape=cylinder, label="_reference/\n1980-2025 baseline\nand outlier fences"];
    go [shape=cylinder, label="datalake_gold/\ngovernance_*.parquet\nstorytelling_*.parquet"];
  }
  out [label="Notebooks 03-04\nDashboard (Workshop 4)"];
  gd -> bd; ia -> bd; bd -> b;
  b -> sd [style=dashed, label="run manifest"];
  sd -> s; s -> gp; ih -> gp; gp -> r [dir=both, label="build / read"];
  r -> sd [style=dashed, label="fences"];
  gp -> go; go -> out;
}
